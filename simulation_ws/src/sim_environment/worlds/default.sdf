<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <!-- Física do Mundo -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
      <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
      <atmosphere type="adiabatic"/>
   
    <!-- Plugins de Sistema do Gazebo -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/> <!--Sistema de Física do Mundo-->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><!--habilita comandos enviados pelo usuário para o simulador-->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><!--visualização da interface gráfica do Gazebo.-->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"> <!-- Habilita a simulação e atualização dos sensores presentes no mundo -->
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Configuração da Cena Visual: Céu e Nuvens -->
    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.8 0.9 1.0 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Iluminação Solar Direcional -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
          <inner_angle>0</inner_angle>
          <outer_angle>0</outer_angle>
          <falloff>0</falloff>
      </spot>
    </light>

    <!-- Plano de Chão  -->
    <include>
        <uri>model://grass_patch</uri> <!--modelo de piso. caminho: /Simulation_LEAD/simulation_ws/src/sim_environment/models-->
    </include>

    <!--Modelo do Aruco-->
    <include>
      <uri>model://ariel_marker</uri>
      <pose>2.0 1.0 0.005 0 0 0</pose>
    </include>

  </world>
</sdf>